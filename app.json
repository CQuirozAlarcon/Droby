{
  "expo": {
    "name": "ERP Accesorios",
    "slug": "erp-accesorios",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "erpaccesorios",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuempresa.erpaccesorios"
    },
    "android": {
      "package": "com.tuempresa.erpaccesorios"
    },
    "web": {
      "name": "ERP Accesorios",
      "shortName": "ERP Accesorios",
      "description": "Gestión de inventario, ventas, consignaciones, finanzas y RRHH para negocios de accesorios de telefonía.",
      "lang": "es",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
